---
interface TabItem {
  name: string;
  role: string;
  quote: string;
  image: string;
  avatarImage: string;
}

interface Props {
  tabs: TabItem[];
}

const { tabs } = Astro.props;
---

<div class="tabs-wrapper">
  <div class="tabs-content">
    {tabs.map((tab, i) => (
      <div
        class={`tab-pane ${i === 0 ? 'is-active' : ''}`}
        data-tab-index={i}
        role="tabpanel"
        id={`tabpanel-${i}`}
        aria-labelledby={`tab-${i}`}
        tabindex="0"
        hidden={i !== 0 ? true : undefined}
      >
        <div class="grid-layout tablet-1-column grid-gap-md" style="align-items: center;">
          <div style="aspect-ratio: 4/3; border-radius: var(--radius-card); overflow: hidden;">
            <img src={tab.image} alt={tab.name} class="cover-image" loading="lazy" />
          </div>
          <div>
            <div style="margin-bottom: var(--space-xl);">
              <div class="paragraph-xl utility-margin-bottom-0"><strong>{tab.name}</strong></div>
              <div>{tab.role}</div>
            </div>
            <p class="paragraph-xl" style="margin-bottom: var(--space-2xl);">&ldquo;{tab.quote}&rdquo;</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="grid-layout desktop-4-column tablet-2-column-1 mobile-portrait-1-column tab-menu" role="tablist" aria-label="Testimonials">
    {tabs.map((tab, i) => (
      <button
        class={`tab-menu-link ${i === 0 ? 'is-active' : ''}`}
        data-tab-target={i}
        role="tab"
        id={`tab-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`tabpanel-${i}`}
        tabindex={i === 0 ? '0' : '-1'}
      >
        <div class="flex-horizontal y-center flex-gap-xs">
          <div class="avatar">
            <img src={tab.avatarImage} alt="" class="cover-image" loading="lazy" />
          </div>
          <div style="text-align: left;">
            <div class="paragraph-sm utility-margin-bottom-0"><strong>{tab.name}</strong></div>
            <div class="paragraph-sm utility-margin-bottom-0">{tab.role}</div>
          </div>
        </div>
      </button>
    ))}
  </div>
</div>

<script>
  function initTabs(wrapper: Element) {
    const tabs = Array.from(wrapper.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(wrapper.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function activateTab(tab: HTMLElement) {
      const idx = tab.getAttribute('data-tab-target');
      if (!idx) return;

      // Deactivate all
      tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
      });
      panels.forEach((p) => {
        p.classList.remove('is-active');
        p.setAttribute('hidden', '');
      });

      // Activate selected
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');
      tab.setAttribute('tabindex', '0');
      tab.focus();

      const panel = wrapper.querySelector(`[data-tab-index="${idx}"]`) as HTMLElement | null;
      if (panel) {
        panel.classList.add('is-active');
        panel.removeAttribute('hidden');
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab));

      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        const currentIndex = tabs.indexOf(tab);
        let newIndex = -1;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          newIndex = (currentIndex + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          newIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          newIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          newIndex = tabs.length - 1;
        }

        if (newIndex >= 0) {
          activateTab(tabs[newIndex]);
        }
      });
    });
  }

  document.querySelectorAll('.tabs-wrapper').forEach(initTabs);
</script>
